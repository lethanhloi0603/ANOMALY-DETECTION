# SQLite is the zero-dependency development default.
DATABASE_URL=sqlite:///../data/runtime/insider_threat.db

# Production example:
# DATABASE_URL=postgresql+psycopg://insider_app:change-me@postgres:5432/insider_threat

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# In production, API_KEY and SCORER_API_KEY are both required and must differ.
API_KEY=
API_KEY_ACTOR=api-key-principal
SCORER_API_KEY=
SCORER_API_KEY_ACTOR=trusted-scorer

CORS_ORIGINS=http://localhost:3000
MAX_BATCH_EVENTS=1000
MAX_REQUEST_BYTES=2097152
# Required before scoring. Export the threshold selected on Validation
# (primary rule: empirical 99.5th percentile), then freeze it for Test.
LOCKED_ALERT_THRESHOLD=
AUTO_CREATE_SCHEMA=true
FRAMEWORK_CONFIG_PATH=config/framework.v5.json
FEATURE_CATALOG_PATH=../machine_learning/config/feature128.v5.json
SEQUENCE_CONFIG_PATH=../machine_learning/config/sequence7.v4.json

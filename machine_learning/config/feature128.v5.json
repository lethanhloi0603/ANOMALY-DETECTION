{
  "schema_version": "feature128.v5",
  "feature_count": 128,
  "runtime_materializer": {
    "authoritative_implementation": "insider_ml.stream_store._features_from_payloads",
    "store_schema_version": "cert-user-day-store.v1",
    "implementation_checksum_required_in_preprocessing_artifact": true,
    "formula_text_in_feature_entries": "documentation_only",
    "zero_semantics": "count/sum features are observed zero on an eligible day with no matching event",
    "missing_semantics": "undefined ratio/statistic/history/baseline is value=0 with feature_mask=false",
    "history_order": "strictly before D; no future or current-day peer event",
    "primary_content_policy": "metadata_only"
  },
  "primary_experiment": {
    "content_policy": "metadata_only",
    "raw_content_allowed": false,
    "ocean_allowed": false,
    "scenario_engineered_chain_features_allowed": false,
    "masked_ablation_only_feature_ids": ["X12", "X13", "X14", "X15"],
    "masked_ablation_semantics": "dimension retained for schema compatibility; feature_mask=false in primary"
  },
  "extension_category_policy": {
    "category_mapping_enabled": false,
    "mapping_version": null,
    "fallback": "neutral_extension_metadata_only"
  },
  "pc_context_policy": {
    "fit_split": "TRAIN",
    "unit": "distinct_user_day",
    "shared_min_distinct_users": 5,
    "shared_max_dominance_exclusive": 0.5,
    "owner_min_dominance_inclusive": 0.5,
    "tie_break": "user_id_ascending",
    "freeze_after_train": true
  },
  "domain_novelty_policy": {
    "history_window_calendar_days": 30,
    "exclude_current_day": true,
    "minimum_prior_http_events": 20,
    "insufficient_history": "mask_false",
    "hostname_normalization": "lowercase_idna_strip_trailing_dot"
  },
  "temporal_baseline": {
    "fixed_business_hours": null,
    "time_representation": "cyclic_minute_of_day",
    "timezone_source": "organization",
    "history_policy": "past_only_primary_references_frozen_after_train",
    "fallback_order": [
      "PERSON",
      "ROLE",
      "GLOBAL"
    ],
    "deviation": "robust_positive_z_of_circular_distance"
  },
